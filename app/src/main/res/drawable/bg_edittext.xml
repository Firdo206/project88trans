<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna dasar -->
    <solid android:color="@android:color/white" />

    <!-- Border tipis -->
    <stroke
        android:width="1dp"
        android:color="#BDBDBD" />

    <!-- Sudut melengkung -->
    <corners android:radius="10dp" />

    <!-- Padding -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
