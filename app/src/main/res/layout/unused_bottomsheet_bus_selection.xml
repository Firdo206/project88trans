<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FAF9FB">

    <!-- Judul -->
    <TextView
        android:id="@+id/txtJudul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Bus"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#000000"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Pilihan Bus -->
    <RadioGroup
        android:id="@+id/radioGroupBus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbBus1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bus Eksekutif 40 Seat (Rp 4.000.000)"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/rbBus2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bus VIP 30 Seat (Rp 3.500.000)"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/rbBus3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bus Medium 20 Seat (Rp 3.000.000)"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingVertical="6dp" />
    </RadioGroup>

    <!-- Tombol Lanjut -->
    <Button
        android:id="@+id/btnLanjutBooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lanjut Booking"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="#E53935"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        android:paddingVertical="10dp" />
</LinearLayout>
