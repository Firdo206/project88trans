<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Item Akun -->
    <LinearLayout
        android:id="@+id/akun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgIconAkun"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_person"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Akun dan keamanan"
            android:layout_marginStart="16dp"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item Riwayat -->
    <LinearLayout
        android:id="@+id/riwayat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgIconRiwayat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_history"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riwayat Pemesanan"
            android:layout_marginStart="16dp"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item Pembayaran -->
    <LinearLayout
        android:id="@+id/pembayaran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgIconPembayaran"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_card"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pembayaran"
            android:layout_marginStart="16dp"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item Alamat -->
    <LinearLayout
        android:id="@+id/alamat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgIconAlamat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_maps"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat Penjemputan/Pengantaran"
            android:layout_marginStart="16dp"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item Bantuan -->
    <LinearLayout
        android:id="@+id/bantuan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgIconBantuan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_question"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pusat Bantuan (FAQ, CS)"
            android:layout_marginStart="16dp"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item Keluar -->
    <LinearLayout
        android:id="@+id/keluar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgIconKeluar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_logout"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keluar"
            android:layout_marginStart="16dp"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
