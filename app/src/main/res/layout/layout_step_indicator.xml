<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Step 1 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/step1"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:gravity="center"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_step_active"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/labelStep1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data Diri"
                android:textSize="14sp"
                android:textColor="#9AA3B2"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="24dp"
            android:layout_height="1dp"/>

        <!-- Step 2 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/step2"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:gravity="center"
                android:text="2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_step_inactive"
                android:textColor="#9AA3B2"/>

            <TextView
                android:id="@+id/labelStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detail Perjalanan"
                android:textSize="14sp"
                android:textColor="#9AA3B2"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="24dp"
            android:layout_height="1dp"/>

        <!-- Step 3 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/step3"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="3"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_step_inactive"
                android:textColor="#9AA3B2"/>

            <TextView
                android:id="@+id/labelStep3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ringkasan Perjalanan"
                android:textSize="14sp"
                android:textColor="#9AA3B2"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

    </LinearLayout>

</HorizontalScrollView>
