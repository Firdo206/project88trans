<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ================= STICKY HEADER PUTIH ================= -->
    <LinearLayout
        android:id="@+id/headerSticky"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="12dp"
        android:padding="16dp"
        android:layout_alignParentTop="true">

        <!-- Back -->
        <ImageView
            android:id="@+id/btnBackSticky"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/black" />

        <!-- Step indicator -->
        <include
            layout="@layout/layout_step_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitleSticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pesan Tiket"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginTop="6dp"/>
    </LinearLayout>


    <!-- ================= SCROLL CONTENT ================= -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSticky"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER MERAH (scrollable) -->
            <LinearLayout
                android:id="@+id/headerMerah"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_header"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTitleDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Data Diri"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"/>
            </LinearLayout>


            <!-- CARD PERJALANAN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPerjalanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="-90dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvTanggal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 hari dua malam"
                        android:textSize="14sp"
                        android:textColor="#333"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEE"
                        android:layout_marginVertical="10dp"/>

                    <TextView
                        android:id="@+id/tvAsal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JOGJA"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333"/>

                    <TextView
                        android:id="@+id/tvBus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BUS BESAR"
                        android:textSize="14sp"
                        android:textColor="#777"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- CARD DETAIL PEMESAN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Detail Pemesanan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Nama -->
                    <TextView
                        android:text="Nama"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvNama"
                        android:text="MUTIARA VANIA ANINDYA"
                        android:textSize="15sp"
                        android:layout_marginBottom="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Email -->
                    <TextView
                        android:text="Email"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvEmail"
                        android:text="mutiaranindya06@gmail.com"
                        android:textSize="15sp"
                        android:layout_marginBottom="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Telepon -->
                    <TextView
                        android:text="No Telepon"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvTelepon"
                        android:text="085234203707"
                        android:textSize="15sp"
                        android:layout_marginBottom="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:gravity="left">

                        <TextView
                            android:text="Iya, itu saya"
                            android:textSize="16sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <Switch
                            android:id="@+id/switchSaya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BUTTON -->
            <Button
                android:id="@+id/btnLanjutkan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="20dp"
                android:text="Selanjutnya"
                android:textAllCaps="true"
                android:background="@drawable/bg_promo_badge"
                android:textColor="@color/black"
                android:elevation="6dp"
                android:padding="12dp"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
