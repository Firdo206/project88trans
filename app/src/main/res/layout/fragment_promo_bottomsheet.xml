<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white"
    tools:context=".Bottom.PromoBottomSheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Judul Promo dan Diskon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPromoTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Early Bird 2024"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:id="@+id/tvPromoDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25%"
                        android:background="@drawable/bg_promo_badge"
                        android:padding="4dp"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />
                </LinearLayout>


                <!-- Kode Promo + SALIN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_kode_box">

                    <TextView
                        android:id="@+id/tvPromoCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EaRL2024"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                    <ImageView
                        android:id="@+id/btnSalin"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_salin"
                        android:padding="4dp"
                        android:background="@drawable/bg_btn_salin"
                        android:contentDescription="Salin Kode Promo" />


            </LinearLayout>

                <!-- Info Tambahan -->
                <TextView
                    android:id="@+id/tvPromoInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berlaku hari ini saja"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp" />

                <!-- Syarat & Ketentuan -->
                <TextView
                    android:id="@+id/tvPromoTermsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Syarat &amp; Ketentuan:"
                    android:textSize="16sp"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPromoTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Berlaku untuk semua paket wisata\n• Booking minimal 30 hari sebelum keberangkatan"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <!-- Pengganti tombol besar -->
                <TextView
                    android:id="@+id/txtInfoPenggunaan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* Jika ingin menggunakan promo, silahkan salin kode promo pada halaman pembayaran"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp"
                    android:textColor="@android:color/darker_gray"
                    android:gravity="center" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
