<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ================= STICKY HEADER ================= -->
    <LinearLayout
        android:id="@+id/headerSticky"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="12dp"
        android:padding="16dp">

        <!-- Back -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/black" />

        <!-- Step indicator -->
        <include
            layout="@layout/layout_step_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitleSticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ringkasan Pesanan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginTop="6dp"/>
    </LinearLayout>



    <!-- ================= SCROLL CONTENT ================= -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSticky"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER MERAH -->
            <LinearLayout
                android:id="@+id/headerMerah"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_header"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTitleDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ringkasan Pesanan"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- CARD DETAIL PERJALANAN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPerjalanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="-90dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Detail Perjalanan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333"/>

                    <TextView
                        android:id="@+id/tvJenis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis: -"
                        android:textColor="#666"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/tvNamaPaketAtauBus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Paket / Armada: -"
                        android:textColor="#666"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/tvTanggal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tanggal: -"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/tvJumlah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah Orang: -"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/tvTotalHarga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Harga: Rp 0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD DATA DIRI -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDataDiri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Data Diri"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvNama"
                        android:text="Nama :"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tvEmail"
                        android:text="Email :"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tvTelepon"
                        android:text="Telepon :"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BUTTON KONFIRMASI -->
            <Button
                android:id="@+id/btnKonfirmasi"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="20dp"
                android:text="Konfirmasi"
                android:backgroundTint="@color/primary_red"
                android:textColor="@color/black"/>
        </LinearLayout>

    </ScrollView>

</RelativeLayout>
