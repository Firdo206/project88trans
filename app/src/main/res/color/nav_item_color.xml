<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warna icon & text ketika dipilih -->
    <item android:color="#000000" android:state_checked="true"/>
    <!-- Warna icon & text ketika ditekan (opsional, sama seperti aktif) -->
    <item android:color="#000000" android:state_pressed="true"/>
    <!-- Warna icon & text default (tidak dipilih) -->
    <item android:color="#000000"/>
</selector>
